library ieee;
use ieee.std_logic_1164.all;
entity machine is
    port
    (
        clk          : in  std_logic;
        data_in      : in  std_logic;
        reset        : in  std_logic;
        student_id   : out std_logic_vector(3 downto 0);
        current_state: out std_logic_vector(3 DOWNTO 0)
    );
end entity;

architecture fsm of machine is
    -- Build an enumerated type with 9 states for 
    -- the state machine (9 states for parsing 9 digits of student id)
    type state_type is (S0, S8, S4, S1, S5, S7, S3, S2, S6);
    -- Register to hold the current state
    signal yfsm : state_type;
begin
    process (clk, reset)
    begin
        if reset = '1' then
            yfsm <= s0;
        elsif (clk'EVENT AND clk = '1') then
            -- Determine the next state synchronously, based on
            -- the current state and the input
            case yfsm is
				  when S0 => if data_in = '0' then yfsm <= S0 else yfsm <= S8 end if;
				  when S8 => if data_in = '0' then yfsm <= S8 else yfsm <= S4 end if;
				  when S4 => if data_in = '0' then yfsm <= S4 else yfsm <= S1 end if;
				  when S1 => if data_in = '0' then yfsm <= S1 else yfsm <= S5 end if;
				  when S5 => if data_in = '0' then yfsm <= S5 else yfsm <= S7 end if;
				  when S7 => if data_in = '0' then yfsm <= S7 else yfsm <= S3 end if;
				  when S3 => if data_in = '0' then yfsm <= S3 else yfsm <= S2 end if;
				  when S2 => if data_in = '0' then yfsm <= S2 else yfsm <= S6 end if;
				  when S6 => if data_in = '0' then yfsm <= S6 else yfsm <= S0 end if;
            end case;
        end if;
    end process;

    -- Implement the Mealy logic here
    process (yfsm, data_in)  -- data_in if reqd only
    begin
        case yfsm is
			  when S0 =>
				 current_state <= "0000";
				 if data_in = '0' then student_id <= "0101"; else student_id <= "0000"; end if;  -- 5 / 0

				when S8 =>
				  current_state <= "0001";
				  if data_in = '0' then student_id <= "0000"; else student_id <= "1000"; end if;  -- 0 / 8

				when S4 =>
				  current_state <= "0010";
				  if data_in = '0' then student_id <= "1000"; else student_id <= "0000"; end if;  -- 8 / 0

				when S1 =>
				  current_state <= "0011";
				  if data_in = '0' then student_id <= "0000"; else student_id <= "0111"; end if;  -- 0 / 7

				when S5 =>
				  current_state <= "0100";
				  if data_in = '0' then student_id <= "0111"; else student_id <= "0001"; end if;  -- 7 / 1

				when S7 =>
				  current_state <= "0101";
				  if data_in = '0' then student_id <= "0001"; else student_id <= "0010"; end if;  -- 1 / 2

				when S3 =>
				  current_state <= "0110";
				  if data_in = '0' then student_id <= "0010"; else student_id <= "0001"; end if;  -- 2 / 1

				when S2 =>
				  current_state <= "0111";
				  if data_in = '0' then student_id <= "0001"; else student_id <= "0100"; end if;  -- 1 / 4

				when S6 =>
				  current_state <= "1000";
				  if data_in = '0' then student_id <= "0100"; else student_id <= "0101"; end if;  -- 4 / 5
				          
		   end case;
    end process;
end fsm;