-- Compare with someelse, this don't seem right

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;
use IEEE.NUMERIC_STD.ALL;

entity ALU2 is
    port( Clock : in std_logic;  -- input clock signal
          A,B : in unsigned(7 downto 0); -- 8-bit inputs from latches A and B
          student_id : in unsigned(3 downto 0); -- 4-bit student id from FSM
          OP : in unsigned(15 downto 0); -- 16-bit selector for Operation from Decoder
          neg : out std_logic; -- is the result negative? Set=1bit output 
          R1 : out unsigned(3 downto 0); -- lower 4-bits of 8-bit Result Output
          R2 : out unsigned(3 downto 0)); -- higher 4-bits of 8-bit Result Output
end ALU2;

architecture calculation of ALU2 is
-- temporary signal declarations.
    signal Reg1, Reg2, Result : unsigned(7 downto 0) := (others => '0');
    signal Reg4 : unsigned(0 to 7);

begin
    Reg1 <= A; -- temporarily store A in Reg1 local variable
    Reg2 <= B; -- temporarily store B in Reg2 local variable

process(Clock) ------ it said Clk here first .... why?! changes it to Clock
begin
    --if(rising_edge(Clock)) THEN -- Do the calculation @ positive edge of clock cycle.
        case OP is
				
				-- Function #1: A - B
            WHEN "0000000000000001" => 
                -- Difference between A and B: ------------------
					 if(Reg1>= Reg2) THEN
						neg <= '0';
						Result <= Reg1-Reg2;
					 else
						neg <= '1';
						Result <= Reg2 - Reg1;
					 end if;
					 
				-- Function #2: 2's complement of B
            WHEN "0000000000000010" => 
                Result <= (not Reg2) + 1;
                neg <= '0';
					 
				-- Function #3: Swap the lower 4 bits of A with lower 4 bits of B:
            WHEN "0000000000000100" => --------------------------
                Result(7 downto 4) <= Reg1(7 downto 4);
                Result(3 downto 0) <= Reg2(3 downto 0);
                neg <= '0';

			   -- Function #4: Produce null on the output
            WHEN "0000000000001000" => ------------------------------
                Result <= (others => '0');
                neg <= '0';
					 
				-- Function #5: Decrement B by 5: -------------------------
            WHEN "0000000000010000" => 
                Result <= Reg2 - "0101";

				-- Function #6: Invert the bit-significance order of A
            WHEN "0000000000100000" => 
                Result(7) <= Reg1(0);
                Result(6) <= Reg1(1);
                Result(5) <= Reg1(2);
                Result(4) <= Reg1(3);
                Result(3) <= Reg1(4);
                Result(2) <= Reg1(5);
                Result(1) <= Reg1(6);
                Result(0) <= Reg1(7);
                neg <= '0';

			   -- Function #7: Shift B to left by 3 bits, input bit = 1 (SHL)
            WHEN "0000000001000000" => 
                Result <= Reg2(4 downto 0) & "111";
                neg <= '0';

				-- Function #8: Increment A by 3:
            WHEN "0000000010000000" => 
					 Result <= Reg1 + "011";
					 neg <= '0';

				-- Function #9: Invert all bits of B
            WHEN "0000000100000000" => 
                Result <= not Reg2;
					 neg <= '0';

            WHEN OTHERS =>
                -- Don't care, do nothing
					 Result <= Result;
        end case;
 --   end if;
end process;

    R1 <= Result(3 downto 0);   -- Since the output seven segments can 
    R2 <= Result(7 downto 4);   -- only 4-bits, split the 8-bit to two 4-bits.

end calculation;